# ============================================================
# 环境变量模板（可提交；真实密钥一律写 .env，不要写这里）
# 用法：copy .env.example .env，再填写真实值
#
# 也可以完全不改这个文件：启动后在「设置」页填密钥、选模型即可，
# 那一页会写回 .env 并重建 Agent。
# ============================================================

# ---------- 模型 ----------
# 可选三个，写死在 core/settings.py：qwen3.7-plus / qwen3.8-max / deepseek-flash
# 接口地址也写死在那里，这里不需要填——同一家的 key 只对应一个网关，
# 让用户配 base_url 只会多一个"填错了但看起来能连"的失败模式。
# 这里只留 LLM_MODEL 作向后兼容：settings.json 没记录时以它为准。
LLM_MODEL=qwen3.7-plus
SUBAGENT_MODEL=
LLM_TEMPERATURE=0.3

# 阿里百炼密钥：Qwen 两个模型都用它（https://dashscope.aliyuncs.com/compatible-mode/v1）
DASHSCOPE_API_KEY=sk-your-dashscope-key

# DeepSeek 密钥：deepseek-flash 与检索共用同一个 Bearer key
# （对话 https://api.deepseek.com/v1，搜索 https://api.deepseek.com）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---------- 检索 ----------
# 可选：deepseek / bocha / mock
# 探针会跳过所有未填 key 的 provider，可以全部填上做横向对比
SEARCH_PROVIDER=deepseek

# 中文查询失败时降级的备选源（留空则不降级）
# 注意：英文查询不会降级——博查的英文结果实测全是中文，降级会让「英文维度」变成假的
SEARCH_FALLBACK=bocha

# 每期检索次数硬上限（含降级重试）。用完后工具会返回错误，模型只能按已有证据收工
SEARCH_QUOTA=24

# 博查（支持 YYYY-MM-DD..YYYY-MM-DD 区间，接口地址写死在 core/sources.py）
BOCHA_API_KEY=

# 智谱与 Tavily 只在探针里做横向对比用，应用本身不调用
ZHIPU_API_KEY=
TAVILY_API_KEY=
